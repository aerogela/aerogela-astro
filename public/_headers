# aerogela.com — Cloudflare Pages 响应头
# 修复审计问题 A9：旧站 HSTS 被显式禁用（max-age=0 + preload 矛盾组合）
# 首次启用 HSTS：先 6 个月、不含子域；稳定 2-4 周后再升级为
# max-age=31536000; includeSubDomains; preload 并到 hstspreload.org 提交

/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# Astro 指纹化静态资源（文件名含 hash，可永久缓存）
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 自托管字体（URL 固定，仅随构建变化，30 天缓存）
/fonts/*
  Cache-Control: public, max-age=2592000

# Pagefind 搜索索引（每次构建内容变化，中等缓存）
/pagefind/*
  Cache-Control: public, max-age=3600