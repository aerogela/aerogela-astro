---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  SITE, canonical, htmlToText, listingSchema, breadcrumbSchema,
} from '../../lib/seo';
import taxonomy from '../../data/taxonomy.json';

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  return listings.map((l) => ({ params: { slug: l.data.slug }, props: { l } }));
}

const { l } = Astro.props;
const e = l.data;
const path = `/listing/${e.slug}/`;
const url = canonical(path);
const desc = e.excerpt || htmlToText(e.content);

// r15 内链网络:同分类横向链接 + 上下文统计(修复 49 条 listing"抓而不编")
const allListings = await getCollection('listings');
const primaryCat = e.category?.[0];
const catMeta = (taxonomy.hp_listing_category || []).find((c) => c.name === primaryCat);
const sameCat = primaryCat
  ? allListings
      .filter((x) => x.data.slug !== e.slug && (x.data.category || []).includes(primaryCat))
      .sort((a, b) => {
        const ra = a.data.review_status === 'reviewed' ? 0 : 1;
        const rb = b.data.review_status === 'reviewed' ? 0 : 1;
        return ra - rb || a.data.title.localeCompare(b.data.title);
      })
  : [];
const related = sameCat.slice(0, 6);
const catTotal = sameCat.length + 1;
const country = e.location?.[0];
const countryCount = country
  ? allListings.filter((x) => (x.data.location || []).includes(country)).length
  : 0;

const STOP = new Set(['and', 'the', 'for', 'with', 'a', 'of', 'in', 'to', 'are', 'on', 'how', 'what', 'vs', 'from', 'real', 'need', 'meets', 'where']);
const kw = [...e.category, ...e.main_products, ...e.application_fields]
  .join(' ')
  .toLowerCase()
  .split(/[^a-z0-9]+/)
  .filter((w) => w.length > 2 && !STOP.has(w));
const relatedPosts = (await getCollection('posts'))
  .map((p) => {
    const t = `${p.data.title} ${p.data.excerpt || ''}`.toLowerCase();
    return { p, score: kw.reduce((s, w) => s + (t.includes(w) ? 1 : 0), 0) };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

// 目录站外链策略统一:正文中的供应商官网链接补 nofollow(与侧栏一致,
// 避免被搜索引擎视为链接农场;博客 DOI 引用链接保持 follow 不受影响)
const contentHtml = e.content.replace(
  /<a\s([^>]*href="https?:\/\/(?!aerogela\.com)[^"]*"[^>]*)>/gi,
  (m, attrs) => {
    if (/nofollow/i.test(attrs)) return m;
    if (/rel="[^"]*"/i.test(attrs)) return m.replace(/rel="([^"]*)"/i, 'rel="nofollow $1"');
    return `<a ${attrs} rel="nofollow noopener">`;
  }
);

const crumbs = [
  { name: 'Home', url: `${SITE.domain}/` },
  { name: 'Suppliers', url: `${SITE.domain}/listing/` },
];
if (catMeta) {
  crumbs.push({ name: catMeta.name, url: `${SITE.domain}/listing-category/${catMeta.slug}/` });
}
crumbs.push({ name: e.title, url });

const schema = [listingSchema(e, url), breadcrumbSchema(crumbs)];
---

<Base title={e.title} description={desc} path={path} schema={schema}>
  <div class="page-head">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="crumb-sep">/</span><a href="/listing/">Suppliers</a>
        {catMeta && <><span class="crumb-sep">/</span><a href={`/listing-category/${catMeta.slug}/`}>{catMeta.name}</a></>}
        <span class="crumb-sep">/</span>{e.title}
      </div>
      <span class="eyebrow">Supplier datasheet</span>
      <h1>{e.title}</h1>
      {e.review_status === 'reviewed' && <span class="verified">Reviewed listing</span>}
    </div>
  </div>

  <div class="wrap">
    <div class="sheet">
      <div class="sheet-main">
        <article data-pagefind-body data-pagefind-filter="type:Supplier">
          <div class="art-meta">
            {e.location?.length && <span class="dt">{e.location.join(', ')}</span>}
            {e.category?.length && <span class="rd">{e.category.join(' · ')}</span>}
          </div>
          <span style="display:none;">
            {e.location?.map((l) => <span data-pagefind-filter="location">{l}</span>)}
            {e.category?.map((c) => <span data-pagefind-filter="category">{c}</span>)}
          </span>
          <div class="prose" set:html={contentHtml} />
        </article>
      </div>

      <aside class="sheet-aside">
        <div class="meta-card">
          <div class="mc-head"><span>Company profile</span><span class="dot"></span></div>
          {e.website && (
            <div class="mc-row">
              <div class="k">Website</div>
              <div class="v"><a href={e.website} rel="nofollow noopener" target="_blank">{e.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗</a></div>
            </div>
          )}
          {e.location?.length ? (
            <div class="mc-row">
              <div class="k">Location</div>
              <div class="v">{e.location.join(', ')}</div>
            </div>
          ) : null}
          {e.category?.length ? (
            <div class="mc-row">
              <div class="k">Category</div>
              <div class="v">{e.category.join(', ')}</div>
            </div>
          ) : null}
          {e.main_products?.length ? (
            <div class="mc-row">
              <div class="k">Main products</div>
              <div class="v">{e.main_products.join(', ')}</div>
            </div>
          ) : null}
          {e.application_fields?.length ? (
            <div class="mc-row">
              <div class="k">Applications</div>
              <div class="v">{e.application_fields.join(', ')}</div>
            </div>
          ) : null}
          {e.certifications ? (
            <div class="mc-row">
              <div class="k">Certifications</div>
              <div class="v">{e.certifications}</div>
            </div>
          ) : null}
          <div class="mc-row">
            <div class="k">Listing data</div>
            <div class="v" style="font-family:var(--font-mono);font-size:0.8rem;color:var(--muted);">
              ID {e.slug}<br />Added {new Date(e.date).toISOString().slice(0, 10)}
            </div>
          </div>
        </div>

        <p style="margin-top:1rem;font-size:0.82rem;color:var(--muted);line-height:1.6;">
          Listing information is provided for sourcing research. Verify specifications and
          certifications directly with the supplier. See our
          <a href="/verification-policy/">verification policy</a>.
        </p>
      </aside>
    </div>
  </div>

  {related.length > 0 && catMeta && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Directory context</span>
          <h2>More {primaryCat} suppliers</h2>
          <p class="sub">
            {e.title} is one of {catTotal} suppliers listed under {primaryCat} on aerogela
            {country && countryCount > 0 && <> — the directory currently tracks {countryCount} aerogel-related companies based in {country}</>}.
            Profiles are reviewed before publication; see our <a href="/how-listings-are-reviewed/">review process</a>.
          </p>
        </div>
        <div class="cards">
          {related.map((r) => (
            <article class="card">
              <span class="loc">{r.data.location?.[0] ?? 'Worldwide'}</span>
              <h3><a href={`/listing/${r.data.slug}/`}>{r.data.title}</a></h3>
              <div class="tags">
                {(r.data.main_products ?? []).slice(0, 2).map((c) => <span class="tag">{c}</span>)}
              </div>
            </article>
          ))}
        </div>
        <p style="margin-top:1.6rem;">
          <a href={`/listing-category/${catMeta.slug}/`}>Browse all {primaryCat} suppliers →</a>
        </p>
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Knowledge base</span>
          <h2>Related technical reading</h2>
        </div>
        <div class="cards">
          {relatedPosts.map(({ p }) => (
            <article class="card">
              <h3><a href={`/blog/${p.data.slug}/`}>{p.data.title}</a></h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>