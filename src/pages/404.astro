---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const listings = await getCollection('listings');
---

<Base title="Page Not Found" description="The page you are looking for does not exist." path="/404" noindex>
  <h1>Page Not Found</h1>
  <p class="muted">The page you are looking for does not exist or has been moved.</p>
  <ul class="muted" style="margin:1rem 0 0;padding-left:1.1rem;">
    <li><a href="/">Home</a></li>
    <li><a href="/listing/">Browse {listings.length} aerogel suppliers</a></li>
    <li><a href="/blog/">Knowledge base</a></li>
    <li><a href="/search/">Search the site</a></li>
  </ul>
</Base>