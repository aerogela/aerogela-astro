---
import '../styles/global.css';
import { SITE, pageTitle, canonical } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, any>[];
}

const { title, description = SITE.description, path, ogImage, noindex = false, schema = [] } =
  Astro.props;

const fullTitle = pageTitle(title);
const canon = canonical(path);
const graph = [
  { '@type': 'Organization', '@id': `${SITE.domain}/#org`, name: SITE.name, url: SITE.domain, description: SITE.description },
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, SITE.domain).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/archivo-400_700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bricolagegrotesque-600_800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <div class="topbar">
      <div class="wrap">
        <span class="fact">The aerogel industry directory<em></em></span>
        <span class="fact">
          <a href="/submit-a-listing/">Submit a listing</a><span class="sep">/</span>
          <a href="/how-listings-are-reviewed/">Review policy</a>
        </span>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap sitebar">
        <a class="brand" href="/">
          <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
            <rect x="1.5" y="8.5" width="16" height="16" rx="3" fill="#0d7684" opacity="0.25" />
            <rect x="5" y="5" width="16" height="16" rx="3" fill="#0d7684" opacity="0.5" />
            <rect x="8.5" y="1.5" width="16" height="16" rx="3" fill="#0d7684" />
          </svg>
          aerogela
        </a>
        <nav class="nav">
          <a href="/listing/">Suppliers</a>
          <a href="/blog/">Knowledge</a>
          <a href="/search/">Search</a>
          <a href="/about-aerogela/">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <div class="foot-brand">
              <svg width="22" height="22" viewBox="0 0 26 26" fill="none" aria-hidden="true">
                <rect x="1.5" y="8.5" width="16" height="16" rx="3" fill="#0d7684" opacity="0.25" />
                <rect x="5" y="5" width="16" height="16" rx="3" fill="#0d7684" opacity="0.5" />
                <rect x="8.5" y="1.5" width="16" height="16" rx="3" fill="#0d7684" />
              </svg>
              aerogela
            </div>
            <p class="foot-about">
              Global directory of aerogel manufacturers, suppliers and distributors — verified
              listings, technical knowledge, and sourcing intelligence.
            </p>
          </div>
          <div class="foot-col">
            <h4>Directory</h4>
            <ul>
              <li><a href="/listing/">All suppliers</a></li>
              <li><a href="/listing-category/aerogel-producers/">Producers</a></li>
              <li><a href="/listing-category/distributors/">Distributors</a></li>
              <li><a href="/listing-category/equipment-materials/">Equipment &amp; materials</a></li>
              <li><a href="/listing-category/research-services/">Research &amp; services</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4>Knowledge</h4>
            <ul>
              <li><a href="/blog/">All articles</a></li>
              <li><a href="/blog/what-is-aerogel-insulation/">What is aerogel insulation</a></li>
              <li><a href="/blog/how-to-choose-aerogel-suppliers/">Choosing suppliers</a></li>
              <li><a href="/search/">Search</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4>Company</h4>
            <ul>
              <li><a href="/about-aerogela/">About</a></li>
              <li><a href="/verification-policy/">Verification policy</a></li>
              <li><a href="/submit-a-listing/">Submit a listing</a></li>
              <li><a href="/privacy-policy-2/">Privacy</a></li>
              <li><a href="/terms-of-use/">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-base">
          <span>© {year} aerogela.com — aerogel industry directory</span>
          <span>Built as a static site · aerogel-insulated 🧊</span>
        </div>
      </div>
    </footer>
  </body>
</html>