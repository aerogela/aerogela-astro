---
import { SITE, pageTitle, canonical } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, any>[];
}

const { title, description = SITE.description, path, ogImage, noindex = false, schema = [] } =
  Astro.props;

const fullTitle = pageTitle(title);
const canon = canonical(path);
const graph = [
  { '@type': 'Organization', '@id': `${SITE.domain}/#org`, name: SITE.name, url: SITE.domain, description: SITE.description },
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canon} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, SITE.domain).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={jsonLd} />
    <style is:global>
      :root {
        --bg: #fafbfc; --surface: #ffffff; --ink: #17202b; --muted: #5b6572;
        --accent: #1f5eff; --rule: #e6eaef;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: 'Noto Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.7; font-size: 16px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
      header.site { border-bottom: 1px solid var(--rule); background: var(--surface); }
      .sitebar { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 0; flex-wrap: wrap; gap: 0.75rem; }
      .brand { font-weight: 800; font-size: 1.25rem; color: var(--ink); }
      nav.main a { margin-left: 1.2rem; font-size: 0.92rem; color: var(--muted); }
      nav.main a:hover { color: var(--ink); }
      main { min-height: 60vh; padding: 2rem 0 3rem; }
      footer.site { border-top: 1px solid var(--rule); padding: 2rem 0; color: var(--muted); font-size: 0.85rem; background: var(--surface); }
      .prose { max-width: 46rem; }
      .prose img { max-width: 100%; height: auto; border-radius: 8px; }
      .prose table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
      .prose th, .prose td { border: 1px solid var(--rule); padding: 0.55rem 0.7rem; text-align: left; }
      .prose h2, .prose h3 { line-height: 1.35; margin-top: 1.8em; }
      h1 { font-size: 1.9rem; line-height: 1.25; margin: 0.4rem 0 0.8rem; }
      .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.2rem; }
      .card { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 1rem 1.15rem; }
      .card h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
      .muted { color: var(--muted); font-size: 0.88rem; }
      .badge { display: inline-block; font-size: 0.74rem; font-weight: 700; padding: 0.08rem 0.55rem; border-radius: 99px; background: #eef2ff; color: var(--accent); margin-right: 0.4rem; }
      .crumb { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.5rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap sitebar">
        <a class="brand" href="/">{SITE.name}</a>
        <nav class="main">
          <a href="/listing/">Suppliers</a>
          <a href="/blog/">Blog</a>
          <a href="/search/">Search</a>
          <a href="/about-aerogela/">About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>{SITE.description} &copy; {new Date().getFullYear()} {SITE.name}.</p>
      </div>
    </footer>
  </body>
</html>